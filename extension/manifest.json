{
  "manifest_version": 3,
  "name": "AirPlay A/V Sync",
  "version": "0.1.0",
  "description": "Delays bilibili video by the AirPlay lead so video matches HomePod audio. Requires the airplay tray app's local API.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:17653/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AirPlay A/V Sync"
  },
  "content_scripts": [
    {
      "matches": ["*://www.bilibili.com/video/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://www.bilibili.com/video/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
